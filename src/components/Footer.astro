---
const today = new Date();
---

<footer>
	<div class="container inner">
		<p class="copy">&copy; {today.getFullYear()} Frank Trout</p>
		<nav class="links" aria-label="Footer">
			<a href="/blog">Blog</a>
			<a href="/about">About</a>
			<a href="/rss.xml">RSS</a>
			<a href="https://github.com/ftrout" target="_blank" rel="noopener">GitHub</a>
			<a href="https://www.linkedin.com/in/fmtrout/" target="_blank" rel="noopener">LinkedIn</a>
		</nav>
	</div>
</footer>
<style>
	footer {
		font-family: var(--font-sans);
		border-top: 1px solid rgb(var(--border));
		color: rgb(var(--gray));
		font-size: var(--step--1);
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-s);
		padding-block: var(--space-m);
	}
	.copy {
		margin: 0;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-s);
	}
	.links a {
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.links a:hover {
		color: var(--accent);
	}
</style>
