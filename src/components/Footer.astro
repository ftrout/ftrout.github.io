---
import { SITE, SOCIALS } from '../consts';

const year = new Date().getFullYear();
const links = [
  { label: 'GitHub', href: SOCIALS.github, me: true },
  { label: 'LinkedIn', href: SOCIALS.linkedin, me: true },
  { label: 'X', href: SOCIALS.x, me: true },
  { label: 'Email', href: SOCIALS.email, me: true },
  { label: 'RSS', href: '/rss.xml', me: false },
].filter((l) => l.href);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-id">
      <strong>{SITE.author}</strong>
      <p>{SITE.footerNote} © {year}</p>
    </div>
    <ul class="footer-links">
      {links.map((l) => (
        <li>
          <a href={l.href} rel={l.me ? 'me noopener' : undefined}>{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>
