---
import { NAV, SITE, SOCIALS } from '../consts';

interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;
const year = new Date().getFullYear();
const socials = [
  { label: 'GitHub', href: SOCIALS.github },
  { label: 'LinkedIn', href: SOCIALS.linkedin },
  { label: 'X', href: SOCIALS.x },
  { label: 'Email', href: SOCIALS.email },
].filter((l) => l.href);
---

<footer class="site-footer">
  <div class:list={['container', { wide }]}>
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/">
          <span>{SITE.title}</span>
        </a>
        <p>{SITE.description}</p>
      </div>
      <div class="footer-col">
        <h2>Navigate</h2>
        <ul>
          {NAV.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="/rss.xml">RSS feed</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h2>Connect</h2>
        <ul>
          {socials.map((l) => (
            <li>
              <a href={l.href} rel="me noopener" target={l.href.startsWith('mailto:') ? undefined : '_blank'}>{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {SITE.author}. All rights reserved.</span>
      <span>Built with <a href="https://astro.build" rel="noopener" target="_blank">Astro</a>. Hosted on GitHub Pages.</span>
    </div>
  </div>
</footer>
