---
import type { SeriesNeighbors } from '../utils/posts';

interface Props {
  neighbors: SeriesNeighbors | null;
}

const { neighbors } = Astro.props;
---

{neighbors && (
  <nav class="series-nav" aria-label="Series navigation">
    <p class="kicker">Series · Part {neighbors.index} of {neighbors.total}</p>
    <h2><a href={`/series/${neighbors.slug}/`}>{neighbors.name}</a></h2>
    <div class="prev-next">
      {neighbors.prev && (
        <a class="prev" href={`/blog/${neighbors.prev.id}/`} rel="prev">
          <span class="label">← Part {neighbors.index - 1}</span>
          <span>{neighbors.prev.data.title}</span>
        </a>
      )}
      {neighbors.next && (
        <a class="next" href={`/blog/${neighbors.next.id}/`} rel="next">
          <span class="label">Part {neighbors.index + 1} →</span>
          <span>{neighbors.next.data.title}</span>
        </a>
      )}
    </div>
  </nav>
)}
