---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header id="site-header">
	<nav class="container">
		<a class="wordmark" href="/">{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://github.com/ftrout" target="_blank" rel="noopener">
				<span class="sr-only">Frank Trout on GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href="https://www.linkedin.com/in/fmtrout/" target="_blank" rel="noopener">
				<span class="sr-only">Frank Trout on LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
						d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
					></path></svg
				>
			</a>
			<a href="/rss.xml">
				<span class="sr-only">RSS feed</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"
					><path
						fill="currentColor"
						d="M2 11.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM0 6.5A9.5 9.5 0 0 1 9.5 16h-2.2A7.3 7.3 0 0 0 0 8.7zM0 1a15 15 0 0 1 15 15h-2.2A12.8 12.8 0 0 0 0 3.2z"
						transform="translate(0.5 -0.5)"></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(10px) saturate(1.4);
		-webkit-backdrop-filter: blur(10px) saturate(1.4);
		/* The hairline only appears once the page has scrolled under the bar. */
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s ease;
	}
	header.scrolled {
		border-bottom-color: rgb(var(--border));
	}

	nav {
		display: flex;
		align-items: center;
		gap: var(--space-m);
		min-height: var(--header-height);
	}

	.wordmark {
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: rgb(var(--black));
		text-decoration: none;
		white-space: nowrap;
		margin-right: auto;
	}
	.wordmark:hover {
		color: var(--accent);
	}

	.internal-links {
		display: flex;
		gap: var(--space-s);
	}
	.internal-links :global(a) {
		position: relative;
		padding: 0.35em 0;
		font-size: var(--step--1);
		font-weight: 500;
		color: rgb(var(--gray));
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.internal-links :global(a:hover) {
		color: rgb(var(--black));
	}
	.internal-links :global(a.active) {
		color: rgb(var(--black));
	}
	.internal-links :global(a.active)::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -2px;
		height: 2px;
		border-radius: 2px;
		background: var(--accent);
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		padding-left: var(--space-s);
		border-left: 1px solid rgb(var(--border));
	}
	.social-links a {
		display: flex;
		color: rgb(var(--gray));
		transition: color 0.15s ease;
	}
	.social-links a:hover {
		color: var(--accent);
	}

	/*
	  Small screens: keep every link reachable instead of dropping the social
	  icons — the wordmark takes the first row, nav and icons share the second.
	*/
	@media (max-width: 560px) {
		nav {
			flex-wrap: wrap;
			row-gap: 0;
			padding-block: var(--space-2xs);
		}
		.wordmark {
			flex-basis: 100%;
			margin-right: 0;
		}
		.internal-links {
			margin-right: auto;
			margin-left: -0.1em;
		}
	}
</style>

<script>
	// Reveal the header hairline only after the page scrolls beneath it.
	function watchHeaderScroll() {
		const header = document.getElementById('site-header');
		if (!header) return;
		const sync = () => header.classList.toggle('scrolled', window.scrollY > 4);
		sync();
		window.addEventListener('scroll', sync, { passive: true });
		// The listener dies with the document on a view transition, so it is
		// re-attached by the astro:page-load below rather than leaking.
		document.addEventListener(
			'astro:before-swap',
			() => window.removeEventListener('scroll', sync),
			{ once: true },
		);
	}
	document.addEventListener('astro:page-load', watchHeaderScroll);
</script>
