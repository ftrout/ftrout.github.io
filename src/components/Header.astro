---
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname;
const isCurrent = (match: readonly string[]) => match.some((m) => path.startsWith(m));
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label={`${SITE.title}, home`}>{SITE.title}</a>
    <nav class="site-nav" aria-label="Primary">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.match) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
