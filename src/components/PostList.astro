---
import { readingTime, type Post } from '../utils/posts';
import { slugify } from '../utils/slug';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => (
    <li>
      <div class="post-date">
        <FormattedDate date={post.data.pubDate} />
      </div>
      <div class="post-body">
        <h3 class="post-title">
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        </h3>
        <p class="post-desc">{post.data.description}</p>
        <div class="meta">
          <TagList tags={post.data.tags} />
          {post.data.series && (
            <span class="meta-item">
              <span class="dot"></span>
              <span><a href={`/series/${slugify(post.data.series)}/`}>{post.data.series}</a>, part {post.data.seriesOrder}</span>
            </span>
          )}
          <span class="meta-item">
            <span class="dot"></span>
            <span>{readingTime(post.body)} min read</span>
          </span>
        </div>
      </div>
    </li>
  ))}
</ul>
