---
import { readingTime, type Post } from '../utils/posts';
import { slugify } from '../utils/slug';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="card featured">
  <a class="card-link" href={`/blog/${post.id}/`} aria-label={post.data.title}></a>
  <p class="eyebrow">Latest post</p>
  <h3><a href={`/blog/${post.id}/`} tabindex="-1">{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <div class="meta">
    <FormattedDate date={post.data.pubDate} />
    {post.data.series && (
      <span class="meta-item">
        <span class="dot"></span>
        <span><a href={`/series/${slugify(post.data.series)}/`}>{post.data.series}</a>, part {post.data.seriesOrder}</span>
      </span>
    )}
    <span class="meta-item">
      <span class="dot"></span>
      <span>{readingTime(post.body)} min read</span>
    </span>
  </div>
  <TagList tags={post.data.tags} />
  <span class="read-more" aria-hidden="true">Read the post →</span>
</article>
