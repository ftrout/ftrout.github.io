---
import { readingTime, type Post } from '../utils/posts';
import { slugify } from '../utils/slug';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, series, seriesOrder, tags } = post.data;
---

<article class="lead-post">
  <p class="kicker">Latest</p>
  <h2 class="lead-title"><a href={`/blog/${post.id}/`}>{title}</a></h2>
  <p class="lead-desc">{description}</p>
  <div class="meta">
    <div class="meta-row">
      <FormattedDate date={pubDate} />
      <span>{readingTime(post.body)} min read</span>
      {series && (
        <span><a href={`/series/${slugify(series)}/`}>{series}</a>, part {seriesOrder}</span>
      )}
      {tags.length > 0 && <span class="meta-tags"><TagList tags={tags} /></span>}
    </div>
  </div>
  <a class="link-arrow" href={`/blog/${post.id}/`} aria-hidden="true" tabindex="-1">Read the post →</a>
</article>
