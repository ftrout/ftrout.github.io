---
import { slugify, tagHue } from '../utils/slug';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tag-list" aria-label="Tags">
    {tags.map((tag) => (
      <li>
        <a class={`tag tag-c${tagHue(slugify(tag))}`} href={`/tags/${slugify(tag)}/`}>{tag}</a>
      </li>
    ))}
  </ul>
)}
