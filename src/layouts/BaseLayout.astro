---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  /** Use the wider content column (article pages with a sidebar). */
  wide?: boolean;
}

const { wide = false, ...head } = Astro.props;
---

<html lang="en">
  <head>
    <Head {...head} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class:list={['container', { wide }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
