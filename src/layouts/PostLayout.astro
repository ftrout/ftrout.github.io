---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import SeriesNav from '../components/SeriesNav.astro';
import { readingTime, type Post, type SeriesNeighbors } from '../utils/posts';

interface Props {
  post: Post;
  neighbors: SeriesNeighbors | null;
}

const { post, neighbors } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
const minutes = readingTime(post.body);
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={heroImage}
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
>
  <article>
    <header class="article-header">
      <p class="eyebrow">Article</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="meta">
        <FormattedDate date={pubDate} />
        {updatedDate && (
          <span class="meta-item">
            <span class="dot"></span>
            <span>Updated <FormattedDate date={updatedDate} /></span>
          </span>
        )}
        <span class="meta-item">
          <span class="dot"></span>
          <span>{minutes} min read</span>
        </span>
      </div>
      <TagList tags={tags} />
      {heroImage && <img class="hero-image" src={heroImage} alt="" />}
    </header>

    <SeriesNav neighbors={neighbors} variant="banner" />

    <div class="prose">
      <slot />
    </div>

    <SeriesNav neighbors={neighbors} variant="full" />
  </article>
</BaseLayout>
