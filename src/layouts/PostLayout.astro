---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import SeriesNav from '../components/SeriesNav.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { readingTime, type Post, type SeriesNeighbors } from '../utils/posts';

interface Props {
  post: Post;
  neighbors: SeriesNeighbors | null;
  headings: MarkdownHeading[];
}

const { post, neighbors, headings } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
const minutes = readingTime(post.body);
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={`/og/${post.id}.png`}
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
>
  <div class="progress" aria-hidden="true" data-progress></div>
  <div class="article-layout" id="top">
    <article>
      <header class="article-header">
        {neighbors && (
          <p class="kicker">
            <a href={`/series/${neighbors.slug}/`}>{neighbors.name}</a> · Part {neighbors.index} of {neighbors.total}
          </p>
        )}
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <div class="meta">
          <div class="meta-row">
            <FormattedDate date={pubDate} />
            {updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
            <span>{minutes} min read</span>
            {tags.length > 0 && <span class="meta-tags"><TagList tags={tags} /></span>}
          </div>
        </div>
        {heroImage && <img class="hero-image" src={heroImage} alt="" />}
      </header>

      <div class="prose" data-prose>
        <slot />
      </div>

      <SeriesNav neighbors={neighbors} />
    </article>

    <aside>
      <TableOfContents headings={headings} />
    </aside>
  </div>
</BaseLayout>

<script>
  // Reading progress bar.
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  if (bar) {
    const update = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, doc.scrollTop / max) : 0})`;
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
  }

  // Heading anchors.
  document.querySelectorAll<HTMLElement>('[data-prose] h2[id], [data-prose] h3[id]').forEach((h) => {
    const a = document.createElement('a');
    a.className = 'heading-anchor';
    a.href = `#${h.id}`;
    a.textContent = '#';
    a.setAttribute('aria-label', `Link to “${h.textContent?.trim()}”`);
    h.append(a);
  });

  // Code blocks: language label, copy button, and a fade when a line runs off the edge.
  const blocks: HTMLElement[] = [];
  document.querySelectorAll<HTMLPreElement>('[data-prose] pre.astro-code').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'code-block';
    const tools = document.createElement('div');
    tools.className = 'code-tools';
    const language = pre.dataset.language;
    if (language && !['plaintext', 'text', 'txt'].includes(language)) {
      const lang = document.createElement('span');
      lang.className = 'code-lang';
      lang.textContent = language;
      tools.append(lang);
    }
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = 'Copied';
        btn.dataset.copied = 'true';
        setTimeout(() => {
          btn.textContent = 'Copy';
          delete btn.dataset.copied;
        }, 1600);
      } catch {
        btn.textContent = 'Failed';
      }
    });
    tools.append(btn);
    pre.replaceWith(wrap);
    wrap.append(tools, pre);
    pre.addEventListener(
      'scroll',
      () => wrap.classList.toggle('at-end', pre.scrollLeft + pre.clientWidth >= pre.scrollWidth - 2),
      { passive: true },
    );
    blocks.push(wrap);
  });
  const measure = () =>
    blocks.forEach((wrap) => {
      const pre = wrap.querySelector('pre')!;
      wrap.classList.toggle('is-overflowing', pre.scrollWidth > pre.clientWidth + 1);
    });
  measure();
  addEventListener('resize', measure);
  document.fonts?.ready.then(measure);

  // Tables scroll inside their own box instead of widening the page.
  document.querySelectorAll<HTMLTableElement>('[data-prose] table').forEach((table) => {
    const wrap = document.createElement('div');
    wrap.className = 'table-wrap';
    wrap.tabIndex = 0;
    wrap.setAttribute('role', 'region');
    wrap.setAttribute('aria-label', 'Table');
    table.replaceWith(wrap);
    wrap.append(table);
  });

  // Table of contents: highlight the section in view.
  const toc = document.querySelector('[data-toc]');
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const byId = new Map(links.map((l) => [decodeURIComponent(l.hash.slice(1)), l]));
    const targets = [...byId.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    let current: HTMLAnchorElement | null = null;
    const setCurrent = (id: string) => {
      const link = byId.get(id);
      if (!link || link === current) return;
      current?.removeAttribute('aria-current');
      link.setAttribute('aria-current', 'true');
      current = link;
    };
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setCurrent(visible[0].target.id);
      },
      { rootMargin: '-15% 0px -70% 0px', threshold: 0 },
    );
    targets.forEach((t) => observer.observe(t));
    if (targets[0]) setCurrent(targets[0].id);
  }
</script>
