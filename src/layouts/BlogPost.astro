---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Adjacent = { slug: string; title: string };
type Props = CollectionEntry<'blog'>['data'] & {
	minutesRead?: string;
	headings?: MarkdownHeading[];
	prev?: Adjacent;
	next?: Adjacent;
};

const { title, description, pubDate, updatedDate, heroImage, author, minutesRead, headings = [], prev, next } =
	Astro.props;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 3;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', name: author },
	url: canonicalURL.href,
};
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
		<style>
			main {
				width: var(--width-wide);
				max-width: calc(100% - 2em);
				margin: auto;
			}
			.hero-image {
				width: 100%;
				margin-bottom: 2em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				margin: 0 auto;
				border-radius: 8px;
				border: 1px solid rgb(var(--border));
			}
			.prose {
				width: 100%;
				max-width: var(--width-content);
				margin: auto;
				color: rgb(var(--gray-dark));
			}
			.layout.has-toc {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 200px;
				gap: 3rem;
				align-items: start;
			}
			.layout.has-toc .prose {
				margin: 0;
			}
			.title {
				margin-bottom: 1.5em;
				text-align: left;
			}
			.title h1 {
				margin: 0 0 0.3em 0;
				font-size: 2.75em;
			}
			.date {
				margin-bottom: 0;
				color: rgb(var(--gray));
				font-family: var(--font-mono);
				font-size: 0.8rem;
				letter-spacing: 0.02em;
			}
			.last-updated-on {
				font-style: italic;
			}

			/* Table of contents */
			.toc {
				position: sticky;
				top: 2rem;
				font-size: 0.85rem;
				line-height: 1.4;
			}
			.toc-title {
				font-family: var(--font-mono);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				font-size: 0.72rem;
				color: rgb(var(--gray));
				margin: 0 0 0.75rem 0;
			}
			.toc ul {
				list-style: none;
				margin: 0;
				padding: 0;
				border-left: 1px solid rgb(var(--border));
			}
			.toc li {
				margin: 0;
			}
			.toc li.depth-3 a {
				padding-left: 1.6rem;
			}
			.toc a {
				display: block;
				padding: 0.3rem 0 0.3rem 0.9rem;
				margin-left: -1px;
				border-left: 1px solid transparent;
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.toc a:hover,
			.toc a.active {
				color: var(--accent);
				border-left-color: var(--accent);
			}
			@media (max-width: 1024px) {
				.layout.has-toc {
					display: block;
				}
				.toc {
					display: none;
				}
			}

			/* Prev / next navigation */
			.post-nav {
				display: flex;
				justify-content: space-between;
				gap: 1.5rem;
				margin-top: 3rem;
				padding-top: 2rem;
				border-top: 1px solid rgb(var(--border));
			}
			.post-nav a {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				text-decoration: none;
				max-width: 48%;
			}
			.post-nav a.older {
				margin-left: auto;
				text-align: right;
			}
			.pn-label {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: rgb(var(--gray));
			}
			.pn-title {
				color: rgb(var(--black));
			}
			.post-nav a:hover .pn-title {
				color: var(--accent);
			}
		</style>
		<style is:global>
			/* These target slotted markdown + JS-injected elements, so they must be global. */
			.prose h2,
			.prose h3 {
				position: relative;
			}
			.prose .anchor {
				position: absolute;
				left: -1.1em;
				padding-right: 0.3em;
				color: rgb(var(--gray));
				text-decoration: none;
				opacity: 0;
				transition: opacity 0.15s ease;
			}
			.prose h2:hover .anchor,
			.prose h3:hover .anchor,
			.prose .anchor:focus {
				opacity: 1;
			}
			.prose .anchor:hover {
				color: var(--accent);
			}
			.prose pre {
				position: relative;
			}
			.prose .copy-btn {
				position: absolute;
				top: 0.5rem;
				right: 0.5rem;
				font-family: var(--font-mono);
				font-size: 0.7rem;
				padding: 0.25em 0.6em;
				border-radius: 6px;
				border: 1px solid rgb(var(--border));
				background: var(--bg);
				color: rgb(var(--gray));
				cursor: pointer;
				opacity: 0;
				transition: opacity 0.15s ease;
			}
			.prose pre:hover .copy-btn {
				opacity: 1;
			}
			.prose .copy-btn:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			@media (max-width: 720px) {
				.prose .anchor {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<div class:list={['layout', { 'has-toc': showToc }]}>
					<div class="prose">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{author && <span> · by {author}</span>}
								{minutesRead && <span> · {minutesRead}</span>}
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							<hr />
						</div>
						<slot />
						{
							(prev || next) && (
								<nav class="post-nav">
									{next && (
										<a class="newer" href={`/blog/${next.slug}/`}>
											<span class="pn-label">← Newer</span>
											<span class="pn-title">{next.title}</span>
										</a>
									)}
									{prev && (
										<a class="older" href={`/blog/${prev.slug}/`}>
											<span class="pn-label">Older →</span>
											<span class="pn-title">{prev.title}</span>
										</a>
									)}
								</nav>
							)
						}
					</div>
					{
						showToc && (
							<aside class="toc">
								<p class="toc-title">On this page</p>
								<ul>
									{toc.map((h) => (
										<li class={`depth-${h.depth}`}>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ul>
							</aside>
						)
					}
				</div>
			</article>
		</main>
		<Footer />

		<script>
			function enhancePost() {
				// Clickable "#" permalink on each heading
				document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]').forEach((h) => {
					if (h.querySelector('.anchor')) return;
					const a = document.createElement('a');
					a.className = 'anchor';
					a.href = `#${h.id}`;
					a.textContent = '#';
					a.setAttribute('aria-label', 'Link to this section');
					h.appendChild(a);
				});

				// Copy button on each code block
				document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
					if (pre.querySelector('.copy-btn')) return;
					const btn = document.createElement('button');
					btn.className = 'copy-btn';
					btn.type = 'button';
					btn.textContent = 'Copy';
					btn.addEventListener('click', async () => {
						const code = pre.querySelector('code');
						await navigator.clipboard.writeText(code?.innerText ?? pre.innerText);
						btn.textContent = 'Copied';
						setTimeout(() => (btn.textContent = 'Copy'), 1500);
					});
					pre.appendChild(btn);
				});

				// Highlight the current section in the TOC while scrolling
				const tocLinks = Array.from(
					document.querySelectorAll<HTMLAnchorElement>('.toc a'),
				);
				if (tocLinks.length) {
					const byId = new Map(tocLinks.map((l) => [l.getAttribute('href')!.slice(1), l]));
					const observer = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (entry.isIntersecting) {
									tocLinks.forEach((l) => l.classList.remove('active'));
									byId.get(entry.target.id)?.classList.add('active');
								}
							}
						},
						{ rootMargin: '0px 0px -75% 0px' },
					);
					document
						.querySelectorAll('.prose h2[id], .prose h3[id]')
						.forEach((h) => observer.observe(h));
				}
			}
			document.addEventListener('astro:page-load', enhancePost);
		</script>
	</body>
</html>
