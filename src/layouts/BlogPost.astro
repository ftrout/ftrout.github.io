---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { titleTransitionName } from '../utils';

type Adjacent = { slug: string; title: string };
type PostData = CollectionEntry<'blog'>['data'];
// `author` and `tags` have schema defaults, so posts always carry them — but
// pages that reuse this layout (e.g. /about) don't, hence Partial.
type Props = Omit<PostData, 'author' | 'tags'> &
	Partial<Pick<PostData, 'author' | 'tags'>> & {
	slug?: string;
	minutesRead?: string;
	headings?: MarkdownHeading[];
	prev?: Adjacent;
	next?: Adjacent;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	author,
	tags = [],
	slug,
	minutesRead,
	headings = [],
	prev,
	next,
} = Astro.props;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 3;

// Falls back to the URL so pages that reuse this layout (e.g. /about) still get
// a stable, unique view-transition name.
const transitionName = titleTransitionName(slug ?? Astro.url.pathname.replaceAll('/', '-'));

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', name: author },
	url: canonicalURL.href,
};
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
		<style>
			.hero-image {
				margin-bottom: var(--space-xl);
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: var(--radius-lg);
				border: 1px solid rgb(var(--border));
			}

			/*
			  One left-aligned reading column on every page. With a table of
			  contents a second track opens to its right; without one the column
			  keeps exactly the same left edge and width.
			*/
			.layout {
				display: grid;
				grid-template-columns: minmax(0, var(--width-content));
			}
			.layout.has-toc {
				grid-template-columns: minmax(0, var(--width-content)) minmax(0, 200px);
				gap: clamp(2rem, 6vw, 4.5rem);
				align-items: start;
			}
			.prose {
				min-width: 0;
				color: rgb(var(--gray-dark));
			}

			.title {
				margin-bottom: var(--space-l);
				padding-bottom: var(--space-m);
				border-bottom: 1px solid rgb(var(--border));
			}
			.title h1 {
				margin: 0;
				font-size: var(--step-4);
				line-height: 1.1;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5ch;
				margin-bottom: var(--space-2xs);
				color: rgb(var(--gray));
				font-family: var(--font-mono);
				font-size: var(--step--2);
				letter-spacing: 0.02em;
			}
			.dot {
				opacity: 0.6;
			}
			.last-updated-on {
				flex-basis: 100%;
				font-style: italic;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-3xs);
				list-style: none;
				margin: var(--space-s) 0 0 0;
				padding: 0;
			}
			.tags li {
				font-family: var(--font-mono);
				font-size: var(--step--2);
				color: rgb(var(--gray));
				padding: 0.15em 0.6em;
				border: 1px solid rgb(var(--border));
				border-radius: 999px;
			}

			/* Table of contents */
			.toc {
				position: sticky;
				top: calc(var(--header-height) + var(--space-m));
				font-size: var(--step--1);
				line-height: 1.4;
			}
			.toc-title {
				margin-bottom: var(--space-2xs);
			}
			.toc ul {
				list-style: none;
				margin: 0;
				padding: 0;
				border-left: 1px solid rgb(var(--border));
			}
			.toc li {
				margin: 0;
			}
			.toc li.depth-3 a {
				padding-left: 1.6rem;
			}
			.toc a {
				display: block;
				padding: 0.3rem 0 0.3rem 0.9rem;
				margin-left: -1px;
				border-left: 1px solid transparent;
				color: rgb(var(--gray));
				text-decoration: none;
				transition:
					color 0.15s ease,
					border-color 0.15s ease;
			}
			.toc a:hover,
			.toc a.active {
				color: var(--accent);
				border-left-color: var(--accent);
			}
			@media (max-width: 1024px) {
				.layout.has-toc {
					display: block;
				}
				.toc {
					display: none;
				}
			}

			/* Prev / next navigation */
			.post-nav {
				display: flex;
				justify-content: space-between;
				gap: var(--space-m);
				margin-top: var(--space-xl);
				padding-top: var(--space-l);
				border-top: 1px solid rgb(var(--border));
			}
			.post-nav a {
				display: flex;
				flex-direction: column;
				gap: var(--space-3xs);
				padding: var(--space-s);
				margin: calc(var(--space-s) * -1);
				border-radius: var(--radius);
				text-decoration: none;
				max-width: 48%;
				transition: background-color 0.15s ease;
			}
			.post-nav a:hover {
				background-color: rgba(var(--gray-light), 0.6);
			}
			.post-nav a.older {
				margin-left: auto;
				text-align: right;
			}
			.pn-label {
				font-family: var(--font-mono);
				font-size: var(--step--2);
				color: rgb(var(--gray));
			}
			.pn-title {
				font-family: var(--font-display);
				font-size: var(--step-0);
				line-height: 1.3;
				color: rgb(var(--black));
				transition: color 0.15s ease;
			}
			.post-nav a:hover .pn-title {
				color: var(--accent);
			}
		</style>
		<style is:global>
			/* These target slotted markdown + JS-injected elements, so they must be global. */
			.prose h2,
			.prose h3 {
				position: relative;
			}
			.prose .anchor {
				position: absolute;
				left: -1.1em;
				padding-right: 0.3em;
				color: rgb(var(--gray));
				text-decoration: none;
				opacity: 0;
				transition: opacity 0.15s ease;
			}
			.prose h2:hover .anchor,
			.prose h3:hover .anchor,
			.prose .anchor:focus-visible {
				opacity: 1;
			}
			.prose .anchor:hover {
				color: var(--accent);
			}
			.prose pre {
				position: relative;
			}
			.prose .copy-btn {
				position: absolute;
				top: 0.5rem;
				right: 0.5rem;
				font-family: var(--font-mono);
				font-size: var(--step--2);
				padding: 0.3em 0.7em;
				border-radius: var(--radius-sm);
				border: 1px solid rgb(var(--border));
				background: var(--bg);
				color: rgb(var(--gray));
				cursor: pointer;
				opacity: 0;
				transition:
					opacity 0.15s ease,
					color 0.15s ease,
					border-color 0.15s ease;
			}
			.prose pre:hover .copy-btn,
			.prose .copy-btn:focus-visible {
				opacity: 1;
			}
			.prose .copy-btn:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			@media (max-width: 720px) {
				.prose .anchor {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<div class:list={['layout', { 'has-toc': showToc }]}>
					<div class="prose">
						<div class="title">
							<div class="meta">
								<FormattedDate date={pubDate} />
								{
									author && (
										<>
											<span class="dot">·</span>
											<span>{author}</span>
										</>
									)
								}
								{
									minutesRead && (
										<>
											<span class="dot">·</span>
											<span>{minutesRead}</span>
										</>
									)
								}
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1 transition:name={transitionName}>{title}</h1>
							{
								tags.length > 0 && (
									<ul class="tags">
										{tags.map((tag) => (
											<li>{tag}</li>
										))}
									</ul>
								)
							}
						</div>
						<slot />
						{
							(prev || next) && (
								<nav class="post-nav">
									{next && (
										<a class="newer" href={`/blog/${next.slug}/`}>
											<span class="pn-label">← Newer</span>
											<span class="pn-title">{next.title}</span>
										</a>
									)}
									{prev && (
										<a class="older" href={`/blog/${prev.slug}/`}>
											<span class="pn-label">Older →</span>
											<span class="pn-title">{prev.title}</span>
										</a>
									)}
								</nav>
							)
						}
					</div>
					{
						showToc && (
							<aside class="toc">
								<p class="eyebrow toc-title">On this page</p>
								<ul>
									{toc.map((h) => (
										<li class={`depth-${h.depth}`}>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ul>
							</aside>
						)
					}
				</div>
			</article>
		</main>
		<Footer />

		<script>
			function enhancePost() {
				// Clickable "#" permalink on each heading
				document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]').forEach((h) => {
					if (h.querySelector('.anchor')) return;
					const a = document.createElement('a');
					a.className = 'anchor';
					a.href = `#${h.id}`;
					a.textContent = '#';
					a.setAttribute('aria-label', 'Link to this section');
					h.appendChild(a);
				});

				// Copy button on each code block
				document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
					if (pre.querySelector('.copy-btn')) return;
					const btn = document.createElement('button');
					btn.className = 'copy-btn';
					btn.type = 'button';
					btn.textContent = 'Copy';
					btn.addEventListener('click', async () => {
						const code = pre.querySelector('code');
						await navigator.clipboard.writeText(code?.innerText ?? pre.innerText);
						btn.textContent = 'Copied';
						setTimeout(() => (btn.textContent = 'Copy'), 1500);
					});
					pre.appendChild(btn);
				});

				// Highlight the current section in the TOC while scrolling
				const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
				if (tocLinks.length) {
					const byId = new Map(tocLinks.map((l) => [l.getAttribute('href')!.slice(1), l]));
					const observer = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (entry.isIntersecting) {
									tocLinks.forEach((l) => l.classList.remove('active'));
									byId.get(entry.target.id)?.classList.add('active');
								}
							}
						},
						{ rootMargin: '0px 0px -75% 0px' },
					);
					document
						.querySelectorAll('.prose h2[id], .prose h3[id]')
						.forEach((h) => observer.observe(h));
				}
			}
			document.addEventListener('astro:page-load', enhancePost);
		</script>
	</body>
</html>
