---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { SERIES_INFO } from '../../consts';
import { getAllSeries, getPosts, type SeriesInfo } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getAllSeries(posts).map((s) => ({
    params: { series: s.slug },
    props: { series: s },
  }));
}

interface Props {
  series: SeriesInfo;
}

const { series } = Astro.props;
const count = series.parts.length;
const intro = SERIES_INFO[series.name]?.description ?? `A ${count}-part series, in reading order.`;
---

<BaseLayout title={series.name} description={intro}>
  <header class="page-header">
    <p class="kicker">Series · {count} {count === 1 ? 'part' : 'parts'}</p>
    <h1>{series.name}</h1>
    <p class="lede">{intro}</p>
  </header>

  <PostList posts={series.parts} level="h2" numbered showSeries={false} />
</BaseLayout>
