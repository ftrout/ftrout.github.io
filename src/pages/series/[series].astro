---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getAllSeries, getPosts, type SeriesInfo } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getAllSeries(posts).map((s) => ({
    params: { series: s.slug },
    props: { series: s },
  }));
}

interface Props {
  series: SeriesInfo;
}

const { series } = Astro.props;
const count = series.parts.length;
const noun = count === 1 ? 'part' : 'parts';
---

<BaseLayout title={series.name} description={`A ${count}-part series: ${series.name}.`}>
  <header class="page-header">
    <p class="eyebrow">Series</p>
    <h1>{series.name}</h1>
    <p class="lede">{count} {noun}, in reading order. <a href="/series/">Browse all series</a></p>
  </header>

  <PostList posts={series.parts} />
</BaseLayout>
