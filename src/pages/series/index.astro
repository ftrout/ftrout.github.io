---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getAllSeries, getPosts } from '../../utils/posts';

const series = getAllSeries(await getPosts());
---

<BaseLayout title="Series" description="Multi-part posts, in reading order.">
  <header class="page-header">
    <p class="eyebrow">Browse</p>
    <h1>Series</h1>
    <p class="lede">Longer topics, split into parts you can read in order.</p>
  </header>

  <ul class="series-grid">
    {series.map((s) => (
      <li class="series-card">
        <h2><a href={`/series/${s.slug}/`}>{s.name}</a></h2>
        <span class="badge">{s.parts.length} {s.parts.length === 1 ? 'part' : 'parts'}</span>
        <ol>
          {s.parts.map((part) => (
            <li>
              <a href={`/blog/${part.id}/`}>{part.data.title}</a>
              <span> · </span><FormattedDate date={part.data.pubDate} />
            </li>
          ))}
        </ol>
      </li>
    ))}
  </ul>
</BaseLayout>
