---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist.">
  <header class="page-header">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="lede">That link doesn't go anywhere. It may have moved, or it never existed.</p>
  </header>
  <div class="hero-actions">
    <a class="btn btn-primary" href="/">Go home</a>
    <a class="btn" href="/blog/">Browse all posts</a>
  </div>
</BaseLayout>
