---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPosts } from '../../utils/posts';
import { tagHue } from '../../utils/slug';

const tags = getAllTags(await getPosts());
---

<BaseLayout title="Tags" description="Posts grouped by topic.">
  <header class="page-header">
    <p class="eyebrow">Browse</p>
    <h1>Tags</h1>
    <p class="lede">Every topic I've written about, with the number of posts in each.</p>
  </header>

  <ul class="tag-list large" aria-label="All tags">
    {tags.map((tag) => (
      <li>
        <a class={`tag tag-c${tagHue(tag.slug)}`} href={`/tags/${tag.slug}/`}>
          {tag.name}<span class="count">{tag.count}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
