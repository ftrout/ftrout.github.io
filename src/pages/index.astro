---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Frank 👋</h1>
			<p>
				{SITE_DESCRIPTION} I write about building production-ready AI agents — the
				operational realities of shipping, securing, and scaling them, alongside the
				responsible-AI practices that keep them trustworthy.
			</p>
			<p>
				Browse the <a href="/blog">blog</a> for field notes and deep dives, or learn more
				<a href="/about">about me</a>. You can also
				<a href="/rss.xml">subscribe via RSS</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
