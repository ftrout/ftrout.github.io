---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE, SOCIALS } from '../consts';
import { getPosts } from '../utils/posts';

const posts = (await getPosts()).slice(0, SITE.postsOnHome);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="section hero">
    <p class="eyebrow">{SITE.role}</p>
    <h1>{SITE.title}</h1>
    <p class="lede">{SITE.tagline}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/blog/">Read the blog</a>
      <a class="btn" href="/about/">About me</a>
      {SOCIALS.github && (
        <a class="btn" href={SOCIALS.github} rel="me noopener" target="_blank">GitHub</a>
      )}
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Latest writing</h2>
      <a href="/blog/">View all posts →</a>
    </div>
    <PostList posts={posts} />
  </section>
</BaseLayout>
