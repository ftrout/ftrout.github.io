---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero column">
				<img class="avatar" src="/profile.jpg" alt="Frank Trout" width="72" height="72" />
				<h1>Building with AI, in production</h1>
				<p class="lead">
					Field notes from shipping, securing, and scaling AI agents — and the
					responsible-AI practices that keep them trustworthy.
				</p>
				<p class="intro">
					I'm Frank Trout. I've spent 25 years in IT, most recently in cybersecurity.
					Now I build AI, and this is where I write about it — the parts that work,
					the parts that don't, and what I learn in between.
				</p>
			</section>

			<section class="writing column">
				<h2 class="eyebrow section-title">Latest writing</h2>
				<ul class="posts">
					{posts.map((post) => <PostCard post={post} headingLevel={3} />)}
				</ul>
				<p class="all-link"><a href="/blog">All posts →</a></p>
			</section>
		</main>
		<Footer />
	</body>

	<style>
		.hero {
			padding-block: var(--space-l) var(--space-2xl);
		}
		.avatar {
			width: 72px;
			height: 72px;
			border-radius: 50%;
			object-fit: cover;
			border: 1px solid rgb(var(--border));
			margin: 0 0 var(--space-m) 0;
		}
		.hero h1 {
			font-size: var(--step-5);
			line-height: 1.05;
			letter-spacing: -0.025em;
			margin: 0 0 var(--space-s) 0;
			max-width: 18ch;
		}
		.lead {
			font-size: var(--step-1);
			line-height: 1.45;
			color: rgb(var(--black));
			max-width: 46ch;
			margin: 0 0 var(--space-m) 0;
		}
		.intro {
			color: rgb(var(--gray));
			max-width: 58ch;
			margin: 0;
		}

		.writing {
			border-top: 1px solid rgb(var(--border));
			padding-top: var(--space-l);
		}
		.section-title {
			margin-bottom: var(--space-s);
		}
		.posts {
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.posts :global(.row:first-child) {
			border-top: none;
		}
		.all-link {
			margin: var(--space-l) 0 0 0;
			font-family: var(--font-mono);
			font-size: var(--step--1);
		}
		.all-link a {
			text-decoration: none;
		}
		.all-link a:hover {
			text-decoration: underline;
		}
	</style>
</html>
