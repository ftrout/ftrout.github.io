---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostList from '../components/PostList.astro';
import { SERIES_INFO, SITE, SOCIALS } from '../consts';
import { getAllSeries, getPosts } from '../utils/posts';

const posts = await getPosts();
const [featured, ...rest] = posts;
const recent = rest.slice(0, SITE.postsOnHome - 1);
const series = getAllSeries(posts);
const initials = SITE.author
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();

// Split the tagline so one phrase can carry the accent colour.
const emphasis = SITE.taglineEmphasis;
const hasEmphasis = Boolean(emphasis) && SITE.tagline.includes(emphasis);
const [leadIn, tailOut] = hasEmphasis ? SITE.tagline.split(emphasis) : [SITE.tagline, ''];
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="hero">
    <div class="hero-text">
      <h1>{leadIn}{hasEmphasis ? <em>{emphasis}</em> : null}{tailOut}</h1>
      <p class="intro">{SITE.intro}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/blog/">Read the writing</a>
        <a class="link-arrow" href="/about/">About me →</a>
        {SOCIALS.github && (
          <a class="link-arrow" href={SOCIALS.github} rel="me noopener">GitHub →</a>
        )}
      </div>
    </div>
    <div class="hero-photo">
      {SITE.avatar ? (
        <img src={SITE.avatar} alt={`Portrait of ${SITE.author}`} width="640" height="640" />
      ) : (
        <span class="initials" aria-hidden="true">{initials}</span>
      )}
    </div>
  </section>

  {featured && <FeaturedPost post={featured} />}

  {recent.length > 0 && (
    <section class="section">
      <div class="section-header">
        <h2>More writing</h2>
        <a class="link-arrow" href="/blog/">All posts →</a>
      </div>
      <PostList posts={recent} />
    </section>
  )}

  {series.length > 0 && (
    <section class="section">
      <div class="section-header">
        <h2>Read in order</h2>
        <a class="link-arrow" href="/topics/">All topics →</a>
      </div>
      {series.map((s) => (
        <div class="series-card">
          <h3><a href={`/series/${s.slug}/`}>{s.name}</a></h3>
          {SERIES_INFO[s.name] && <p class="series-desc">{SERIES_INFO[s.name].description}</p>}
          <p class="series-actions">
            <a class="btn" href={`/blog/${s.parts[0].id}/`}>Start with part 1</a>
            <a class="link-arrow" href={`/series/${s.slug}/`}>All {s.parts.length} parts →</a>
          </p>
        </div>
      ))}
    </section>
  )}
</BaseLayout>
