---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostCard from '../components/PostCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE, SOCIALS } from '../consts';
import { getAllSeries, getAllTags, getPosts } from '../utils/posts';

const posts = await getPosts();
const [featured, ...rest] = posts;
const recent = rest.slice(0, SITE.postsOnHome - 1);
const series = getAllSeries(posts);
const topics = getAllTags(posts).slice(0, 8);
const initials = SITE.author
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="section hero">
    <div>
      <p class="eyebrow">{SITE.role}</p>
      <h1>
        Hi, I'm <em>{SITE.author}</em>.
      </h1>
      <p class="lede">{SITE.tagline}</p>
      <p class="intro">{SITE.intro}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/blog/">Read the blog</a>
        <a class="btn" href="/about/">About me</a>
        {SOCIALS.github && (
          <a class="btn" href={SOCIALS.github} rel="me noopener" target="_blank">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>
        )}
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="inner">
        {SITE.avatar ? <img src={SITE.avatar} alt="" /> : initials}
      </div>
    </div>
  </section>

  {topics.length > 0 && (
    <div class="topics">
      <span class="label">Writing about</span>
      <ul class="tag-list">
        {topics.map((t) => (
          <li><a class="tag" href={`/tags/${t.slug}/`}>{t.name}</a></li>
        ))}
      </ul>
    </div>
  )}

  {featured && (
    <section class="section">
      <FeaturedPost post={featured} />
    </section>
  )}

  {recent.length > 0 && (
    <section class="section">
      <div class="section-header">
        <div>
          <p class="eyebrow">Recent</p>
          <h2>More writing</h2>
        </div>
        <a class="more" href="/blog/">View all posts →</a>
      </div>
      <ul class="post-grid">
        {recent.map((post) => <PostCard post={post} />)}
      </ul>
    </section>
  )}

  {series.length > 0 && (
    <section class="section">
      <div class="section-header">
        <div>
          <p class="eyebrow">Series</p>
          <h2>Read in order</h2>
        </div>
        <a class="more" href="/series/">All series →</a>
      </div>
      <div class="series-spotlight">
        {series.map((s) => (
          <div class="card series-card">
            <a class="card-link" href={`/series/${s.slug}/`} aria-label={s.name}></a>
            <h3><a href={`/series/${s.slug}/`} tabindex="-1">{s.name}</a></h3>
            <span class="badge">{s.parts.length} {s.parts.length === 1 ? 'part' : 'parts'}</span>
            <ol>
              {s.parts.map((part) => (
                <li>
                  <a href={`/blog/${part.id}/`}>{part.data.title}</a>
                  <FormattedDate date={part.data.pubDate} />
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
