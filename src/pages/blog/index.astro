---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, type Post } from '../../utils/posts';

const posts = await getPosts();

const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="Writing" description="Everything Frank Trout has written, newest first.">
  <header class="page-header">
    <h1>Writing</h1>
    <p class="lede">Everything I've written, newest first. Browse by <a href="/topics/">topic or series</a> instead.</p>
  </header>

  {years.map((year) => (
    <section class="year-group" aria-labelledby={`y${year}`}>
      <h2 class="year-heading" id={`y${year}`}>{year}</h2>
      <PostList posts={byYear.get(year)!} dateStyle="short" />
    </section>
  ))}
</BaseLayout>
