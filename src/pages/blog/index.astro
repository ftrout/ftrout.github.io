---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group the (already newest-first) posts under year headings.
const byYear: { year: number; posts: typeof posts }[] = [];
for (const post of posts) {
	const year = post.data.pubDate.getFullYear();
	const last = byYear.at(-1);
	if (last?.year === year) last.posts.push(post);
	else byYear.push({ year, posts: [post] });
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head column">
				<h1>Blog</h1>
				<p class="count">
					{posts.length}
					{posts.length === 1 ? 'post' : 'posts'}
				</p>
			</header>

			<div class="column">
				{
					byYear.map(({ year, posts: yearPosts }) => (
						<section class="year">
							<h2 class="eyebrow year-label">{year}</h2>
							<ul class="posts">
								{yearPosts.map((post) => (
									<PostCard post={post} headingLevel={3} />
								))}
							</ul>
						</section>
					))
				}
			</div>
		</main>
		<Footer />
	</body>

	<style>
		.page-head {
			padding-block: var(--space-s) var(--space-l);
		}
		.page-head h1 {
			margin: 0 0 var(--space-3xs) 0;
		}
		.count {
			margin: 0;
			font-family: var(--font-mono);
			font-size: var(--step--2);
			letter-spacing: 0.02em;
			color: rgb(var(--gray));
		}

		.year + .year {
			margin-top: var(--space-xl);
		}
		.year-label {
			margin-bottom: var(--space-s);
		}
		.posts {
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.posts :global(.row:first-child) {
			border-top: none;
		}
	</style>
</html>
